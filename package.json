{
  "name": "karta-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:data": "tsx scripts/check-data.ts",
    "check:permissions": "tsx scripts/check-permissions.ts",
    "check:leads": "tsx scripts/check-leads.ts",
    "check:mutations": "tsx scripts/check-mutations.ts",
    "check:dashboard": "tsx scripts/check-dashboard.ts",
    "check:team": "tsx scripts/check-team.ts",
    "check:reports": "tsx scripts/check-reports.ts",
    "check:accounts": "tsx scripts/check-accounts.ts",
    "check:home": "tsx scripts/check-home.ts",
    "check:deal": "tsx scripts/check-deal.ts",
    "db:seed": "tsx --env-file=.env.test.local scripts/seed-supabase.mts",
    "check:rls": "tsx --env-file=.env.test.local scripts/check-rls.mts",
    "check:secrets": "node --env-file-if-exists=.env.local scripts/check-secrets.mjs",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=desktop",
