# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings → API). Both are safe to expose to the
# browser: the publishable key only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# One-click demo sign-in with the seeded accounts ("true" to enable).
NEXT_PUBLIC_DEMO_MODE=true
# Password of the seeded demo accounts (server-only). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# then create the accounts: npx tsx --env-file=.env.local scripts/seed-users-sql.ts
DEMO_PASSWORD=replace-me

# Freeze the app's calendar for the demo data (remove to use the real date).
NEXT_PUBLIC_APP_TODAY=2026-10-28
