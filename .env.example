# Two env files, never committed:
#   .env.local       the live workspace (real data). `npm run dev` uses it.
#   .env.test.local  the test project (karta-test, fictional demo data). Tests,
#                    `npm run dev:test`, `db:seed` and `check:rls` use it.
# Copy this file to each and fill in that project's values.

# Supabase project (Project Settings → API). Both are safe to expose to the
# browser: the publishable key only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Server-only: lets admins create members and set temporary passwords.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Live workspace: false. Test project: true, plus the demo password and the
# frozen calendar the seeded demo data was built around.
NEXT_PUBLIC_DEMO_MODE=false
# DEMO_PASSWORD=replace-me
# NEXT_PUBLIC_APP_TODAY=2026-10-28
